<screen>
	<view extends="lv_obj" flex_flow="column">
		<style name="page" />
		<lv_obj flex_grow="1" width="100%" flex_flow="column">
			<style name="content" />
			<lv_obj
				width="100%"
				height="content"
				flex_flow="row"
				style_flex_main_place="space_between"
				style_flex_cross_place="center"
				style_bg_opa="0"
				style_border_width="0"
				style_pad_all="0"
				style_pad_bottom="4"
			>
				<lv_label text="Barometer">
					<style name="title" />
				</lv_label>
				<lv_obj>
					<style name="dot" />
				</lv_obj>
			</lv_obj>

			<lv_obj width="100%" height="content" flex_flow="column">
				<style name="card_style" />
				<lv_label text="ALTITUDE">
					<style name="label_xs" />
				</lv_label>
				<lv_obj
					width="100%"
					height="content"
					flex_flow="row"
					style_flex_cross_place="end"
					style_pad_column="6"
					style_bg_opa="0"
					style_border_width="0"
					style_pad_all="0"
					style_pad_top="4"
				>
					<lv_label bind_text="alt_str">
						<style name="hero" />
					</lv_label>
					<lv_label bind_text="alt_unit" style_pad_bottom="6">
						<style name="unit" />
					</lv_label>
				</lv_obj>
			</lv_obj>

			<lv_obj
				width="100%"
				height="content"
				flex_flow="row"
				style_pad_column="8"
				style_bg_opa="0"
				style_border_width="0"
				style_pad_all="0"
			>
				<metric_tile caption="TEMP" value_subject="temp_str" unit_str="F" />
				<metric_tile caption="PRESSURE" value_subject="press_str" unit_str="hPa" />
			</lv_obj>
		</lv_obj>
		<switcher />
	</view>
</screen>
