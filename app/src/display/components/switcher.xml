<component>
	<view
		extends="lv_obj"
		width="100%"
		height="50"
		flex_flow="row"
		style_flex_main_place="space_evenly"
		style_flex_cross_place="center"
		style_pad_all="0"
		style_pad_top="4"
		style_pad_bottom="4"
	>
		<style name="navbar" />

		<lv_button
			width="36"
			height="40"
			style_bg_opa="0"
