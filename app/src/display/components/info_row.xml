<component>
	<api>
		<prop type="string" name="key" default="" />
		<prop type="subject" name="value_subject" default="" />
	</api>
	<view
		extends="lv_obj"
		width="100%"
		height="content"
		flex_flow="row"
		style_flex_main_place="space_between"
		style_flex_cross_place="center"
		style_bg_opa="0"
		style_border_width="0"
		style_pad_all="0"
		style_pad_top="4"
		style_pad_bottom="4"
	>
		<lv_label text="$key">
			<style name="label_xs" />
		</lv_label>
		<lv_label bind_text="$value_subject">
			<style name="value_sm" />
		</lv_label>
	</view>
</component>
