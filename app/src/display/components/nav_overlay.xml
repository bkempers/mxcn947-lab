<component>
	<view
		extends="lv_obj"
		name="nav_backdrop"
		width="320"
		height="480"
		style_bg_color="0x000000"
		style_bg_opa="140"
		style_border_width="0"
		style_radius="0"
		style_pad_all="0"
	>
		<!-- Center card -->
		<lv_obj
			name="nav_card"
			width="280"
			height="content"
			align="center"
			flex_flow="column"
			style_pad_all="16"
			style_pad_row="8"
		>
			<style name="card_style" />

			<!-- Title row -->
			<lv_obj
				width="100%"
				height="content"
				flex_flow="row"
				style_flex_main_place="space_between"
				style_flex_cross_place="center"
				style_bg_opa="0"
				style_border_width="0"
				style_pad_all="0"
			>
				<lv_label text="Navigate">
					<style name="title" />
				</lv_label>

				<lv_button
					name="nav_close"
					width="32"
					height="32"
					style_bg_opa="0"
					style_border_width="0"
				>
					<lv_label text="&#xf00d;" align="center">
						<style name="icon" />
					</lv_label>
				</lv_button>
			</lv_obj>

			<!-- Grid slot: C code populates this with screen items -->
			<lv_obj
				name="nav_grid"
				width="100%"
				height="content"
				flex_flow="column"
				style_pad_row="8"
				style_bg_opa="0"
				style_border_width="0"
				style_pad_all="0"
			>
			</lv_obj>
		</lv_obj>
	</view>
</component>
