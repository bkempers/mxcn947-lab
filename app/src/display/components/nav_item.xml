<component>
	<api>
		<prop type="string" name="icon_text" />
		<prop type="string" name="label_text" />
	</api>
	<view
		extends="lv_obj"
		height="56"
		style_flex_grow="1"
		flex_flow="column"
		style_flex_cross_place="center"
		style_flex_main_place="center"
		style_pad_top="6"
		style_pad_bottom="4"
		style_pad_left="2"
		style_pad_right="2"
		style_pad_row="2"
		style_radius="10"
		style_bg_color="#pillbg"
		style_bg_opa="255"
		style_border_width="1"
		style_border_color="#border"
		style_bg_color-checked="#accent"
		style_bg_opa-checked="40"
		style_border_color-checked="#accent"
	>
		<lv_label text="$icon_text" align="center">
			<style name="icon" />
		</lv_label>
		<lv_label text="$label_text" align="center" style_text_align="center" width="100%">
			<style name="label_xs" />
		</lv_label>
	</view>
</component>
