#include <zephyr/dt-bindings/display/panel.h>
#include <zephyr/dt-bindings/mipi_dbi/mipi_dbi.h>
#include <zephyr/dt-bindings/sensor/lsm6dso.h>

&flexcomm2 {
    status = "okay";
};

&flexcomm2_lpi2c2 {
    clock-frequency = <I2C_BITRATE_STANDARD>;   /* 400 kHz; */

    bmp581: bmp581@47 {
        compatible = "bosch,bmp581";
        reg = <0x47>;
        status = "okay";
    };

    lsm6dsox: lsm6dsox@6a {
        compatible = "st,lsm6dso";
        reg = <0x6a>;
        /* optional tuning — defaults are fine to start */
        accel-range = <LSM6DSO_DT_FS_4G>;
        accel-odr   = <LSM6DSO_DT_ODR_104Hz>;
        gyro-range  = <LSM6DSO_DT_FS_500DPS>;
        gyro-odr    = <LSM6DSO_DT_ODR_104Hz>;
    };

    lis3mdl: lis3mdl@1c {
        compatible = "st,lis3mdl-magn";
        reg = <0x1c>;
    };
};

&flexcomm1_lpspi1 {
    /delete-property/ dmas;
    /delete-property/ dma-names;
    /* dmas = <&edma0 4 0x47>, <&edma0 5 0x48>; */
    /* dma-names = "rx", "tx"; */
    cs-gpios = <&gpio0 27 GPIO_ACTIVE_LOW>;
};

/ {
    chosen {
        zephyr,display = &st7789v;
    };

    mipi_dbi_st7789v {
        compatible = "zephyr,mipi-dbi-spi";
        spi-dev = <&flexcomm1_lpspi1>;
        dc-gpios = <&gpio0 26 GPIO_ACTIVE_HIGH>;
        reset-gpios = <&gpio0 29 GPIO_ACTIVE_LOW>;
        write-only;
        #address-cells = <1>;
        #size-cells = <0>;

        st7789v: st7789v@0 {
            compatible = "sitronix,st7789v";
            reg = <0>;
            mipi-max-frequency = <32000000>;
            mipi-mode = "MIPI_DBI_MODE_SPI_4WIRE";
            width = <240>;
            height = <320>;
            x-offset = <0>;
            y-offset = <0>;
            vcom = <0x19>;
            gctrl = <0x35>;
            vrhs = <0x12>;
            vdvs = <0x20>;
            mdac = <0x00>;
            gamma = <0x01>;
            colmod = <0x55>;
            lcm = <0x2c>;
            porch-param = [0c 0c 00 33 33];
            cmd2en-param = [5a 69 02 01];
            pwctrl1-param = [a4 a1];
            pvgam-param = [D0 04 0D 11 13 2B 3F 54 4C 18 0D 0B 1F 23];
            nvgam-param = [D0 04 0C 11 13 2C 3F 44 51 2F 1F 1F 20 23];
            ram-param = [00 F0];
            rgb-param = [CD 08 14];
        };
    };
};

/ {
	aliases {
		baro-bmp581 = &bmp581;
        imu-lsm6dsox = &lsm6dsox;
        mag-lis3mdl = &lis3mdl;
	};
};
